fn new main/
    println("=== Shiden Language Documentation Examples ===")/
    println("")/

    demo_types()/
    println("")/

    demo_variables()/
    println("")/

    demo_expressions()/
    println("")/

    demo_control_flow()/
    println("")/

    demo_functions()/
    println("")/

    demo_arrays()/
    println("")/

    println("=== All demos completed! ===")/
fn/

fn new demo_types/
    println("--- Types Demo ---")/

    let count = 42/u64
    println("u64: {}", count)/

    let age = 25/i64
    println("i64: {}", age)/

    let temp = 98/f64
    println("f64: {}", temp)/
    println("floats are currently broken")/

    let name = "Shiden"/str
    println("str: {}", name)/

    let grade = 'A'/char
    println("char: {}", grade)/

    let ready = true/bool
    println("bool: {}", ready)/

    println("Types demo complete")/
fn/

fn new demo_variables/
    println("--- Variables Demo ---")/

    let immutable = 10/i64
    println("Immutable variable: {}", immutable)/

    let mut mutable = 5/i64
    println("Initial mutable: {}", mutable)/
    mutable = mutable + 3/
    println("After assignment: {}", mutable)/

    let nums = [1, 2, 3]/array
    println("Array before: {}", nums[1])/
    nums[1] = 99/
    println("Array after index assignment: {}", nums[1])/

    println("Variables demo complete")/
fn/

fn new demo_expressions/
    println("--- Expressions Demo ---")/

    let sum = 1 + 2/i64
    println("Addition: 1 + 2 = {}", sum)/

    let product = 3 * 4/i64
    println("Multiplication: 3 * 4 = {}", product)/

    let result = (1 + 2) * 3/i64
    println("Grouped: (1 + 2) * 3 = {}", result)/

    let neg = -5/i64
    println("Unary minus: -5 = {}", neg)/

    let comparison = 10 > 5/bool
    println("Comparison: 10 > 5 = {}", comparison)/

    let logical = true && false/bool
    println("Logical AND: true && false = {}", logical)/

    let or_result = true || false/bool
    println("Logical OR: true || false = {}", or_result)/

    let not_val = !false/bool
    println("Logical NOT: !false = {}", not_val)/

    println("Expressions demo complete")/
fn/

fn new demo_control_flow/
    println("--- Control Flow Demo ---")/

    if 5 > 3/
        println("if: 5 is greater than 3")/
    if/

    if 2 > 10/
        println("This won't print")/
    else/
        println("else: 2 is not greater than 10")/
    if/

    let mut counter = 0/i64
    while counter < 3/
        println("while: iteration {}", counter)/
        counter = counter + 1/
    while/

    for n in [10, 20, 30]/
        println("for: element {}", n)/
    for/

    let mut x = 0/i64
    while x < 5/
        x = x + 1/
        if x == 2/
            println("continue: skipping 2")/
            continue/
        if/
        if x == 4/
            println("break: stopping at 4")/
            break/
        if/
        println("Loop value: {}", x)/
    while/

    println("Control flow demo complete")/
fn/

fn new demo_functions/
    println("--- Functions Demo ---")/

    simple_function()/

    let value = function_with_return()/i64
    println("Function returned: {}", value)/

    let sum = add_numbers(10, 20)/i64
    println("add_numbers(10, 20) = {}", sum)/

    println("Functions demo complete")/
fn/

fn new simple_function/
    println("Simple function with no parameters or return value")/
fn/

fn new function_with_return/
    return 42/
fn/

fn new add_numbers(a, b)/
    return a + b/
fn/

fn new demo_arrays/
    println("--- Arrays Demo ---")/

    let numbers = [1, 2, 3, 4, 5]/array
    println("Array element at index 0: {}", numbers[0])/
    println("Array element at index 2: {}", numbers[2])/

    let mut dynamic = []/array
    push(dynamic, 100)/
    push(dynamic, 200)/
    push(dynamic, 300)/
    println("Dynamic array length: {}", len(dynamic))/
    println("Dynamic array element: {}", dynamic[1])/

    println("Arrays demo complete")/
fn/