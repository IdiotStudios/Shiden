fn new demonstrate_spacing/
    let x = 1 + 2/i64
    let y = 3 * 4/i64
    let z = x + y/i64
    return z/i64
fn/

fn new demonstrate_indentation/
    if true/
        println("Properly indented")/unit
        if false/
            println("Nested indentation")/unit
        if/
    if/
fn/

fn new demonstrate_function_calls/
    println("No space before parentheses")/unit
    add(1, 2)/i64
    multiply(3, 4, 5)/i64
fn/

fn new add(a/i64, b/i64)/i64
    return a + b/i64
fn/

fn new multiply(a/i64, b/i64, c/i64)/i64
    return a * b * c/i64
fn/
