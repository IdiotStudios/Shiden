fn new utoa(n/i64)/str
    if n == 0/i64/
        return "0"/str
    if/

    let mut digits = []/array
    let mut x = n/i64
    while x > 0/i64/
        let q = x / 10/i64
        let rem = x - q * 10/i64
        let ch = rem + 48/i64
        push(digits, ch)/unit
        x = q/i64
    while/

    let mut out = []/array
    let mut i = len(digits)/i64 - 1/i64
    while i >= 0/i64/
        push(out, digits[i])/unit
        if i == 0/i64/
            break/
        if/
        i = i - 1/i64
    while/
    return out/str
fn/

fn new parse_path(req/str)/str
    let mut i = 0/i64
    let n = len(req)/i64

    while i < n/
        let ch = req[i]/i64
        if ch == 32/
            i = i + 1/i64
            break/
        if/
        i = i + 1/i64
    while/

    let mut path = []/array
    while i < n/
        let ch = req[i]/i64
        if ch == 32/
            break/
        if/
        push(path, ch)/unit
        i = i + 1/i64
    while/

    let path_len = len(path)/i64
    if path_len == 0/
        push(path, 47)/unit
    if/
    return path/str
fn/

fn new build_full_path(path/str)/str
    let mut full = []/array
    for c in "examples/http server/web"/
        push(full, c)/unit
    for/
    for c in path/
        push(full, c)/unit
    for/

    let mut has_dot = false/bool
    for c in path/
        if c == 46/
            has_dot = true/bool
        if/
    for/

    let plen = len(path)/i64
    if plen > 0/i64/
        let idx = plen - 1/i64
        let last = path[idx]/i64
        if last == 47/
            for c in "index.html"/
                push(full, c)/unit
            for/
        if/
        if !has_dot && !(last == 47)/
            push(full, 47)/unit
            for c in "index.html"/
                push(full, c)/unit
            for/
        if/
    if/
    return full/str
fn/

fn new get_mime_type(path/str)/str
    let plen = len(path)/i64
    if plen > 4/i64/
        let idx4 = plen - 4/i64
        let ch1 = path[idx4]/i64
        let o1 = idx4 + 1/i64
        let ch2 = path[o1]/i64
        let o2 = idx4 + 2/i64
        let ch3 = path[o2]/i64
        let o3 = idx4 + 3/i64
        let ch4 = path[o3]/i64
        
        if ch1 == 46 && ch2 == 99 && ch3 == 115 && ch4 == 115/
            return "text/css"/str
        if/
    if/
    
    if plen > 3/i64/
        let idx3 = plen - 3/i64
        let ch1 = path[idx3]/i64
        let o1 = idx3 + 1/i64
        let ch2 = path[o1]/i64
        let o2 = idx3 + 2/i64
        let ch3 = path[o2]/i64
        
        if ch1 == 46 && ch2 == 106 && ch3 == 115/
            return "text/javascript"/str
        if/
    if/
    
    return "text/html"/str
fn/

fn new send_headers_with_type(client/i64, bytes/i64, mime_type/str)/unit
    net_send(client, "HTTP/1.1 200 OK\r\nContent-Type: ")/i64
    net_send(client, mime_type)/i64
    net_send(client, "\r\n\r\n")/i64
fn/

fn new main/
    println("Shiden HTTP Server listening on http://localhost:8000")/unit
    println("Serving files from disk using pure syscalls!")/unit
    let server = net server new(8001)/i64
    println("Server socket created with fd: {}", server)/unit
    let buffer = heap_alloc(65536)/i64

    while true/
        let client = net_server_accept(server)/i64
        
        let req_cstr = net_recv(client)/i64
        let req = __cstr_to_string(req_cstr)/str
        let path = parse_path(req)/str
        let file_path = build_full_path(path)/str
        
        let bytes = fs_read(file_path, buffer, 65536)/i64
        
        if bytes > 0/i64/
            let mime_type = get_mime_type(file_path)/str
            send_headers_with_type(client, bytes, mime_type)/unit
            net_send_raw(client, buffer, bytes)/i64
        if/

        if bytes <= 0/i64/
            net_send(client, "HTTP/1.1 404 Not Found\r\n\r\n")/i64
        if/

        net_close(client)/i64
    while/
fn/
