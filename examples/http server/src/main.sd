fn new parse_path(req)/
    let mut i = 0/i64
    let n = len(req)/i64

    while i < n/
        let ch = req[i]/i64
        if ch == 32/
            i = i + 1/
            break/
        if/
        i = i + 1/
    while/

    let mut path = []/array
    while i < n/
        let ch = req[i]/i64
        if ch == 32/
            break/
        if/
        push(path, ch)/
        i = i + 1/
    while/

    let path_len = len(path)/i64
    if path_len == 0/
        push(path, 47)/
    if/
    return path/
fn/

fn new build_full_path(path)/
    let mut full = []/array
    for c in "examples/http server/web"/
        push(full, c)/
    for/
    for c in path/
        push(full, c)/
    for/

    let mut has_dot = false/bool
    for c in path/
        if c == 46/
            has_dot = true/
        if/
    for/

    let plen = len(path)/i64
    if plen > 0/
        let idx = plen - 1/i64
        let last = path[idx]/i64
        if last == 47/
            for c in "index.html"/
                push(full, c)/
            for/
        if/
        if !has_dot && !(last == 47)/
            push(full, 47)/
            for c in "index.html"/
                push(full, c)/
            for/
        if/
    if/
    return full/
fn/

fn new get_mime_type(path)/
    let plen = len(path)/i64
    if plen > 4/
        let idx4 = plen - 4/i64
        let ch1 = path[idx4]/i64
        let o1 = idx4 + 1/i64
        let ch2 = path[o1]/i64
        let o2 = idx4 + 2/i64
        let ch3 = path[o2]/i64
        let o3 = idx4 + 3/i64
        let ch4 = path[o3]/i64
        
        if ch1 == 46 && ch2 == 99 && ch3 == 115 && ch4 == 115/
            return "text/css"/
        if/
    if/
    
    if plen > 3/
        let idx3 = plen - 3/i64
        let ch1 = path[idx3]/i64
        let o1 = idx3 + 1/i64
        let ch2 = path[o1]/i64
        let o2 = idx3 + 2/i64
        let ch3 = path[o2]/i64
        
        if ch1 == 46 && ch2 == 106 && ch3 == 115/
            return "text/javascript"/
        if/
    if/
    
    return "text/html"/
fn/

fn new send_headers_with_type(client, bytes, mime_type)/
    net_send(client, "HTTP/1.1 200 OK\r\nContent-Type: ")/
    net_send(client, mime_type)/
    net_send(client, "\r\n\r\n")/
fn/

fn new main/
    println("Shiden HTTP Server listening on http://localhost:8001")/
    println("Serving files from disk using pure syscalls!")/
    let server = net server new(8001)/i64
    println("Server socket created with fd: {}", server)/
    let buffer = heap_alloc(65536)/i64
    println("Buffer allocated at: {}", buffer)/

    while true/
        let client = net_server_accept(server)/i64
        
        let req_cstr = net_recv(client)/i64
        let req = __cstr_to_string(req_cstr)/str
        let path = parse_path(req)/str
        let file_path = build_full_path(path)/str
        
        let bytes = fs_read(file_path, buffer, 65536)/i64
        
        if bytes > 0/
            let mime_type = get_mime_type(file_path)/str
            send_headers_with_type(client, bytes, mime_type)/
            net_send_raw(client, buffer, bytes)/
        if/

        if bytes <= 0/
            net_send(client, "HTTP/1.1 404 Not Found\r\n\r\n")/
        if/

        net_close(client)/
    while/
fn/