    println("i105: {}, i110: {}, i115: {}, i120: {}, i121: {}, i122: {}, i123: {}, i124: {}", i105_val, i110_val, i115_val, i120_val, i121_val, i122_val, i123_val, i124_val)/
    
    let i125_val = 54/i125/
    let i126_val = 55/i126/
    let i127_val = 56/i127/
    let i128_val = 57/i128/
    println("i125: {}, i126: {}, i127: {}, i128: {}", i125_val, i126_val, i127_val, i128_val)/
    println("✓ All signed types i1-i128 demonstrated")/
    println("")/
    
    println("--- FLOATING POINT TYPES: f16, f32, f64, f80, f128 (5 types) ---")/
    let f16_val = 3.14/f16/
    let f32_val = 3.14159/f32/
    let f64_val = 3.141592653589793/f64/
    let f80_val = 3.14159265358979323846/f80/
    let f128_val = 3.14159265358979323846/f128/
    println("f16: {}", f16_val)/
    println("f32: {}", f32_val)/
    println("f64: {}", f64_val)/
    println("f80: {}", f80_val)/
    println("f128: {}", f128_val)/
    println("✓ All float types f16, f32, f64, f80, f128 demonstrated")/
    println("")/
    
    println("--- TEXT TYPES: str, char (2 types) ---")/
    let str_val = "Every type in Shiden is now demonstrated!"/str/
    let char_val = 'A'/char/
    println("str: {}", str_val)/
    println("char: {}", char_val)/
    println("✓ All text types str, char demonstrated")/
    println("")/
    
    println("--- CONTAINER TYPE: array (1 type) ---")/
    let array_val = [1, 2, 3, 4, 5]/array/
    println("array: contains 5 elements")/
    println("✓ Container type array demonstrated")/
    println("")/
    
    println("--- SPECIAL TYPES: bool, unit, import (3 types) ---")/
    let bool_true = true/bool/
    let bool_false = false/bool/
    println("bool (true): {}", bool_true)/
    println("bool (false): {}", bool_false)/
    println("unit type: used for effect-only operations")/
    println("import type: for module declarations")/
    println("✓ All special types bool, unit, import demonstrated")/
    println("")/
    
    println("=== COMPLETE TYPE SYSTEM DEMONSTRATION ===")/
    println("Total Types: 128 unsigned + 128 signed + 5 floats + 2 text + 1 container + 3 special = 267+ types")/
fn/
