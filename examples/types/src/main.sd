    println("i65: {}, i70: {}, i75: {}, i80: {}, i85: {}, i90: {}, i95: {}, i100: {}", i65_val, i70_val, i75_val, i80_val, i85_val, i90_val, i95_val, i100_val)/
    
    let i105_val = 46/i105/
