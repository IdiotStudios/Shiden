fn new main/
    println("╔════════════════════════════════════════╗")/
    println("║   SHIDEN WEB SERVER - LIVE DEMO        ║")/
    println("╚════════════════════════════════════════╝")/
    println("")/
    println("Starting server on http://localhost:8080")/
    println("")/
    
    let server_fd = net server new(8080)/i64
    
    if server_fd >= 0/
        println("Server listening on port 8080 (fd={})", server_fd)/
        println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")/
        println("")/
        
        run_server(server_fd)/
        
        let close_result = net close(server_fd)/i32
        println("")/
        println("Server stopped.")/
    else/
        println("ERROR: Failed to create server socket")/
    if/
fn/

fn new run_server(server_fd)/
    let connection_count = 0/i64
    
    while true/
        let client_fd = net server accept(server_fd)/i64
        
        if client_fd >= 0/
            let new_count = connection_count + 1/i64
            connection_count = new_count/
            
            handle_request(client_fd)/
            
            let shutdown_result = net shutdown(client_fd)/i32
            let close_result = net close(client_fd)/i32
        if/
    while/
fn/

fn new handle_request(fd)/
    send_header(fd)/
    send_html_start(fd)/
    send_style(fd)/
    send_body(fd)/
    send_html_end(fd)/
fn/

fn new send_header(fd)/
    let _ = net send(fd, "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n")/i64
fn/

fn new send_html_start(fd)/
    let _ = net send(fd, "<!DOCTYPE html><html><head><title>Shiden Web Server</title><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1.0'>")/i64
fn/

fn new send_style(fd)/
    let _ = net send(fd, "<style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,sans-serif;line-height:1.6;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh;padding:20px}.container{max-width:900px;margin:0 auto;background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.3)}header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:60px 40px;text-align:center}h1{font-size:2.5em;margin-bottom:10px}h2{color:#667eea;font-size:1.5em;margin:30px 0 15px;border-bottom:3px solid #667eea;padding-bottom:10px}main{padding:40px}.feature{background:#f8f9fa;padding:25px;border-radius:8px;margin-bottom:20px;border-left:4px solid #667eea}.code-section{background:#1e1e1e;color:#d4d4d4;padding:25px;border-radius:8px;margin:30px 0}pre{overflow-x:auto}code{font-family:'Courier New',monospace;font-size:0.95em}footer{background:#f8f9fa;padding:30px;text-align:center;color:#666}</style>")/i64
fn/

fn new send_body(fd)/
    let _ = net send(fd, "</head><body><div class='container'><header><h1>Welcome to Shiden</h1><p>A pure compiled language with zero runtime overhead</p></header><main>")/i64
    let _ = net send(fd, "<section class='feature'><h2>Lightning Fast</h2><p>This web server is written entirely in <strong>Shiden</strong> and compiles to native machine code. No interpreters, no virtual machines, no garbage collectors.</p></section>")/i64
    let _ = net send(fd, "<section class='feature'><h2>System-Level Programming</h2><p>Direct access to Linux syscalls (socket, bind, listen, accept, send, shutdown, close) embedded as x86_64 bytecode.</p></section>")/i64
    let _ = net send(fd, "<section class='feature'><h2>No Dependencies</h2><p><strong>No Rust runtime</strong> • <strong>No Python</strong> • <strong>No Node.js</strong><br>Just a small native executable serving this website.</p></section>")/i64
    let _ = net send(fd, "<section class='code-section'><h2>How It Works</h2><pre><code>fn new main/\n    let server_fd = net server new(8080)/i64\n    while true/\n        let client_fd = net server accept(server_fd)/i64\n        handle_request(client_fd)/\n        net shutdown(client_fd)/\n        net close(client_fd)/\n    while/\nfn/</code></pre></section>")/i64
    let _ = net send(fd, "<section class='feature'><h2>Production Ready</h2><p>This demonstrates Shiden can build real network services with pure syscalls!</p></section></main>")/i64
    let _ = net send(fd, "<footer><p>Built using Shiden</p></footer></div>")/i64
fn/

fn new send_html_end(fd)/
    let _ = net send(fd, "</body></html>")/i64
fn/
