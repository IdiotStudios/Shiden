fn new main/
    println("=== SHIDEN NETWORKING LIVE DEMO ===")/
    println("")/

    test_server_creation()/
    println("")/

    test_http_response_sending()/
    println("")/

    test_multiple_ports()/
    println("")/

    test_real_http_server()/
    println("")/

    println("=== DEMO COMPLETE ===")/
    println("All socket operations tested successfully!")/
fn/

fn new test_server_creation/
    println("[TEST 1] Create and manage HTTP server sockets")/
    println("Creating server on port 8080...")/
    
    let fd = net server new(8080)/i64
    
    if fd >= 0/
        println("SUCCESS: Server socket created")/
        println("  - File descriptor: {}", fd)/
        println("  - Port: 8080")/
        println("  - Status: LISTENING")/
        
        println("Closing server...")/
        let result = net close(fd)/i32
        
        if result == 0/
            println("SUCCESS: Server closed cleanly")/
        else/
            println("WARNING: Close returned {}", result)/
        if/
    else/
        println("FAILED: Could not create server (fd={})", fd)/
    if/
fn/

fn new test_http_response_sending/
    println("[TEST 2] Send real HTTP response bytes")/
    println("Building HTTP/1.1 200 OK response...")/
    
    println("")/
    println("Sending to stdout (fd=1):")/
    
    let h = net send byte(1, 72)/i64     
    let t1 = net send byte(1, 84)/i64    
    let t2 = net send byte(1, 84)/i64    
    let p = net send byte(1, 80)/i64     
    let sl = net send byte(1, 47)/i64    
    let one = net send byte(1, 49)/i64   
    let dot = net send byte(1, 46)/i64   
    let two = net send byte(1, 49)/i64   
    let sp = net send byte(1, 32)/i64    
    let tw = net send byte(1, 50)/i64    
    let ze1 = net send byte(1, 48)/i64   
    let ze2 = net send byte(1, 48)/i64   
    let sp2 = net send byte(1, 32)/i64   
    let o = net send byte(1, 79)/i64     
    let k = net send byte(1, 75)/i64     
    let nl = net send byte(1, 10)/i64    
    
    println("")/
    println("SUCCESS: Sent complete HTTP status line")/
    println("  - Total operations: 16")/
    println("  - Content: HTTP/1.1 200 OK")/
fn/

fn new test_multiple_ports/
    println("[TEST 3] Create servers on multiple ports")/
    
    let fd1 = net server new(9001)/i64
    let fd2 = net server new(9002)/i64
    let fd3 = net server new(9003)/i64
    
    println("Port 9001: fd={}", fd1)/
    println("Port 9002: fd={}", fd2)/
    println("Port 9003: fd={}", fd3)/
    
    if fd1 >= 0/
        if fd2 >= 0/
            if fd3 >= 0/
                println("SUCCESS: Created 3 simultaneous servers")/
                
                let c1 = net close(fd1)/i32
                let c2 = net close(fd2)/i32
                let c3 = net close(fd3)/i32
                
                println("All servers closed")/
            if/
        if/
    if/
fn/

fn new test_real_http_server/
    println("[TEST 4] Real HTTP server - waiting for connections")/
    println("Creating server on port 7777...")/
    println("")/
    
    let server_fd = net server new(7777)/i64
    
    if server_fd >= 0/
        println("Server listening on port 7777 (fd={})", server_fd)/
        println("Connect with: curl http://localhost:7777")/
        println("Waiting for connection (will accept 1 connection)...")/
        println("")/
        
        let client_fd = net server accept(server_fd)/i64
        
        if client_fd >= 0/
            println("SUCCESS: Client connected! (fd={})", client_fd)/
            println("Sending HTTP response...")/
            println("")/
            
            let s1 = net send byte(client_fd, 72)/i64
            let s2 = net send byte(client_fd, 84)/i64
            let s3 = net send byte(client_fd, 84)/i64
            let s4 = net send byte(client_fd, 80)/i64
            let s5 = net send byte(client_fd, 47)/i64
            let s6 = net send byte(client_fd, 49)/i64
            let s7 = net send byte(client_fd, 46)/i64
            let s8 = net send byte(client_fd, 49)/i64
            let s9 = net send byte(client_fd, 32)/i64
            let s10 = net send byte(client_fd, 50)/i64
            let s11 = net send byte(client_fd, 48)/i64
            let s12 = net send byte(client_fd, 48)/i64
            let s13 = net send byte(client_fd, 32)/i64
            let s14 = net send byte(client_fd, 79)/i64
            let s15 = net send byte(client_fd, 75)/i64
            let s16 = net send byte(client_fd, 13)/i64
            let s17 = net send byte(client_fd, 10)/i64
            let s18 = net send byte(client_fd, 13)/i64
            let s19 = net send byte(client_fd, 10)/i64
            let s20 = net send byte(client_fd, 72)/i64
            let s21 = net send byte(client_fd, 101)/i64
            let s22 = net send byte(client_fd, 108)/i64
            let s23 = net send byte(client_fd, 108)/i64
            let s24 = net send byte(client_fd, 111)/i64
            let s25 = net send byte(client_fd, 32)/i64
            let s26 = net send byte(client_fd, 102)/i64
            let s27 = net send byte(client_fd, 114)/i64
            let s28 = net send byte(client_fd, 111)/i64
            let s29 = net send byte(client_fd, 109)/i64
            let s30 = net send byte(client_fd, 32)/i64
            let s31 = net send byte(client_fd, 83)/i64
            let s32 = net send byte(client_fd, 104)/i64
            let s33 = net send byte(client_fd, 105)/i64
            let s34 = net send byte(client_fd, 100)/i64
            let s35 = net send byte(client_fd, 101)/i64
            let s36 = net send byte(client_fd, 110)/i64
            let s37 = net send byte(client_fd, 33)/i64
            
            println("Response sent successfully!")/
            println("Content: HTTP/1.1 200 OK + Hello from Shiden!")/
            
            let client_close = net close(client_fd)/i32
            println("Client connection closed (status={})", client_close)/
        else/
            println("ERROR: Failed to accept connection")/
        if/
        
        let server_close = net close(server_fd)/i32
        println("Server socket closed (status={})", server_close)/
    else/
        println("ERROR: Could not create server")/
    if/
fn/

