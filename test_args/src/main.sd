fn new main/
    println("Testing args() built-in function")/unit
    println("=================================")/unit
    println("")/unit
    
    let arguments = args()/array
    let arg_count = len(arguments)/i64
    
    println("Number of arguments: {}", arg_count)/unit
    println("")/unit
    
    if arg_count == 0/
        println("No arguments provided (args() returns empty array for now)")/unit
    else/
        println("Arguments received:")/unit
        let mut i = 0/i64
        while i < arg_count/
            let arg = arguments[i]/str
            println("  arg[{}] = {}", i, arg)/unit
            i = i + 1/i64
        while/
    if/
    
    println("")/unit
    println("✓ args() function is callable!")/unit
fn/
