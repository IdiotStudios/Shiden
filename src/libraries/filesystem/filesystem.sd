# Basic File Operations
fn new fs read(path/str)/str
    __fs_read(path)/str
fn/

fn new fs write(path/str, content/str)/unit
    __fs_write(path, content)/unit
fn/

fn new fs exists(path/str)/i64
    __fs_exists(path)/i64
fn/

fn new fs delete_file(path/str)/unit
    __fs_delete_file(path)/unit
fn/

fn new fs file_size(path/str)/i64
    __fs_file_size(path)/i64
fn/

# Directory Operations
fn new fs mkdir(path/str)/unit
    __fs_mkdir(path)/unit
fn/

fn new fs list_dir(path/str)/str
    __fs_list_dir(path)/str
fn/

# JSON File Operations
fn new fs edit(path/str, key/str, value/str)/unit
    __fs_edit(path, key, value)/unit
fn/

fn new fs edit_strategy(path/str, key/str, value/str, strat/str)/unit
    __fs_edit_strategy(path, key, value, strat)/unit
fn/

fn new fs delete(path/str, key/str)/unit
    __fs_delete(path, key)/unit
fn/

fn new fs array_append(path/str, key/str, value/str)/unit
    __fs_array_append(path, key, value)/unit
fn/

fn new fs merge(path/str, json_str/str)/unit
    __fs_merge(path, json_str)/unit
fn/