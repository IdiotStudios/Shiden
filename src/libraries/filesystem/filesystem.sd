# Basic File Operations
fn new fs read(path)/
    __fs_read(path)/
fn/

fn new fs write(path, content)/
    __fs_write(path, content)/
fn/

fn new fs exists(path)/
    __fs_exists(path)/
fn/

fn new fs delete_file(path)/
    __fs_delete_file(path)/
fn/

fn new fs file_size(path)/
    __fs_file_size(path)/
fn/

# Directory Operations
fn new fs mkdir(path)/
    __fs_mkdir(path)/
fn/

fn new fs list_dir(path)/
    __fs_list_dir(path)/
fn/

# JSON File Operations
fn new fs edit(path, key, value)/
    __fs_edit(path, key, value)/
fn/

fn new fs edit_strategy(path, key, value, strat)/
    __fs_edit_strategy(path, key, value, strat)/
fn/

fn new fs delete(path, key)/
    __fs_delete(path, key)/
fn/

fn new fs array_append(path, key, value)/
    __fs_array_append(path, key, value)/
fn/

fn new fs merge(path, json_str)/
    __fs_merge(path, json_str)/
fn/